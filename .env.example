# Server listening port
PORT=3000

# Redis connection URL (Supports standard redis:// and TLS rediss:// from Upstash / Redis Cloud)
# Local: redis://127.0.0.1:6379
# Upstash: rediss://default:YOUR_PASSWORD@YOUR_ENDPOINT.upstash.io:6379
REDIS_URL=redis://127.0.0.1:6379

# Secret Bearer Token required for authenticating POST /publish requests
PUBLISH_SECRET_KEY=chronostream_dev_secret_key_change_in_production

# Allowed CORS origins (comma-separated or * for public access)
# Examples: * or http://localhost:5173,https://myfrontend.com
ALLOWED_ORIGINS=*

# Environment mode (development / production)
NODE_ENV=development
